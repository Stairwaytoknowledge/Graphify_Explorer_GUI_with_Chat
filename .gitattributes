# Force LF on shell scripts and Unix-style files so they work on macOS/Linux
# even when committed from Windows.
*.sh        text eol=lf
*.command   text eol=lf
*.py        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
Makefile    text eol=lf

# Force CRLF on Windows-only scripts.
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.vbs       text eol=crlf
*.ps1       text eol=crlf

# Treat icons as binary so git never mangles them.
*.png       binary
*.ico       binary
*.icns      binary
